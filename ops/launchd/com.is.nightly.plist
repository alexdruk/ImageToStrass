<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template (spec section 15): tools/install-agents.sh fills in __REPO__, __HOME__, __NODE__,
     __CLOUDFLARED__ and __PATH__ and installs it in ~/Library/LaunchAgents. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.is.nightly</string>
	<key>ProgramArguments</key>
	<array>
		<string>__NODE__</string>
		<string>__REPO__/src/ops/nightly.js</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__REPO__</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>__PATH__</string>
		<key>HOME</key>
		<string>__HOME__</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>3</integer>
		<key>Minute</key>
		<integer>30</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>__REPO__/logs/nightly-run.log</string>
	<key>StandardErrorPath</key>
	<string>__REPO__/logs/nightly-run.log</string>
</dict>
</plist>
