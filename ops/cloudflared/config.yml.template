# Template (spec section 15): tools/install-agents.sh writes it to ~/.cloudflared/config.yml with the
# id of the named tunnel "is", only when that file does not exist yet. The origin is 127.0.0.1,
# never localhost (which can resolve to ::1, where nothing listens).
tunnel: __TUNNEL_ID__
credentials-file: __HOME__/.cloudflared/__TUNNEL_ID__.json

ingress:
  - hostname: patternnifty.com
    service: http://127.0.0.1:3003
  - hostname: www.patternnifty.com
    service: http://127.0.0.1:3003
  - service: http_status:404
